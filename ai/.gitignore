.venv/
.venv-ragas/
__pycache__/
*.pyc
.env
.env*.local
.pytest_cache/

# Raw downloaded corpus (reproducible via scripts/fetch_corpus.py).
# manifest.json IS committed for provenance.
data/raw/

# Eval artifacts. The published result tables (eval_real.*, agent_eval.*,
# injection_eval.*, ragas_scores.*) ARE committed — they're the evidence the
# project trades on. Ignore only the bulky/partial ones:
# (a trailing "#" comment would be part of the pattern, so keep them on their own lines)
# ~370 KB, regenerated by export_for_ragas
eval/results/ragas_input.json
# offline placeholder run
eval/results/eval_fake.*
# judge-less runs — retrieval columns only, see harness.save()
eval/results/*_retrieval.*
